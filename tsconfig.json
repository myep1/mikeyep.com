{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react", 
    "types": ["vite/client", "react", "react-dom"],
    "lib": ["DOM", "DOM.Iterable", "ES2020"]
  },
  "include": ["src"]
}

